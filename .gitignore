# build output
dist/
build/
*.spec
__pycache__/

# Driver installers: ~9 MB of binaries, fetched at build time by
# tools/fetch_drivers.py, which build.bat calls.
drivers/

# local state
assist_log*.csv
debug.log
assist_lite_config.json

# local helpers for diagnosing a particular machine
get_assets*.bat
app-icon*.jpg
check.bat
probe.bat
probe_velocity.py
disable_genitech.bat
fix_icon_cache.bat
icon - Copy.png
log*.csv

# Drafts of release notes stay local; CHANGELOG.md is tracked.
RELEASE_NOTES_v*.md

# Subset UI fonts, regenerated at build time by tools/subset_font.py
assets/fonts/

# The build number, stamped in by build.bat from the commit count
assets/build.txt
